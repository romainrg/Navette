    "The certificate of “%@” is not trusted" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le certificat de « %@ » n'est pas approuvé"
          }
        }
      }
    },
    "The connection is encrypted, but this Mac cannot verify who is at the other end. Trust this certificate only if you know where it comes from; Navette will then accept exactly this one for this server." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion est chiffrée, mais ce Mac ne peut pas vérifier qui se trouve à l'autre bout. N'approuvez ce certificat que si vous savez d'où il vient ; Navette acceptera alors exactement celui-ci pour ce serveur."
          }
        }
      }
    },
