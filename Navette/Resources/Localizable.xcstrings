    },
    "The key this server presents is not the one saved on this Mac. The server may have been reinstalled, or someone may be intercepting the connection. Navette did not connect." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé que présente ce serveur n'est pas celle enregistrée sur ce Mac. Le serveur a peut-être été réinstallé, ou quelqu'un intercepte peut-être la connexion. Navette ne s'est pas connectée."
